<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructFlow - Beam Views" Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Width" Value="60"/><Setter Property="Margin" Value="0,2,12,2"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Width" Value="240"/><Setter Property="Margin" Value="0,2,12,2"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="6"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,14,2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Slider"><Setter Property="Width" Value="220"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
            <Setter Property="TickFrequency" Value="5"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock x:Name="info" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="Setup"/>
            <ComboBox x:Name="preset" IsEditable="True" SelectionChanged="preset_changed"/>
            <Button Content="Save setup" Width="90" Margin="0,0,8,0" Click="save_click"/>
            <Button Content="Delete" Width="70" Click="delete_click"/>
        </WrapPanel>

        <TabControl Padding="8">
            <TabItem Header="Views">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Section type"/><ComboBox x:Name="section_type"/>
                        <TextBlock Text="Margin around beam (mm)"/><TextBox x:Name="margin"/>
                    </WrapPanel>
                    <GroupBox>
                        <GroupBox.Header><CheckBox x:Name="make_elev" Content="Long section / elevation along the beam" Margin="0"/></GroupBox.Header>
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Scale 1 :"/><ComboBox x:Name="scale_elev" IsEditable="True" Width="70"/>
                                <TextBlock Text="View template"/><ComboBox x:Name="template_elev"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="Name"/><TextBox x:Name="elev_name" Width="200"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="Raise top of view"/><Slider x:Name="raise_elev"/>
                                <TextBlock Text="{Binding ElementName=raise_elev, Path=Value, StringFormat={}{0:0}%}" Width="45"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Cross sections">
                        <StackPanel>
                            <WrapPanel>
                                <CheckBox x:Name="sec_start" Content="Start"/>
                                <CheckBox x:Name="sec_mid" Content="Midspan"/>
                                <CheckBox x:Name="sec_end" Content="End"/>
                                <CheckBox x:Name="per_span" Content="For every span (between supports)"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="Start/end cut from support face (mm)"/><TextBox x:Name="sec_offset"/>
                                <TextBlock Text="View depth (mm)"/><TextBox x:Name="sec_depth"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="Scale 1 :"/><ComboBox x:Name="scale_section" IsEditable="True" Width="70"/>
                                <TextBlock Text="View template"/><ComboBox x:Name="template_section"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="Name"/><TextBox x:Name="sec_name" Width="200"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="Raise top of view"/><Slider x:Name="raise_sec"/>
                                <TextBlock Text="{Binding ElementName=raise_sec, Path=Value, StringFormat={}{0:0}%}" Width="45"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap"
                               Text="Name codes: {L} beam letter (A, B, C... kept on re-run), {n} section number in that beam, {mark}, {type}. {L}-{L} gives A-A; {L}{n}-{L}{n} gives A1-A1, A2-A2. If a view template controls scale or detail level, the template wins."/>
                    <CheckBox x:Name="replace_old" Content="Replace views StructFlow made before for these beams"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Rebar display">
                <StackPanel>
                    <GroupBox Header="Links in the long section">
                        <ComboBox x:Name="elev_links" Width="380"/>
                    </GroupBox>
                    <GroupBox Header="Bars of the beams that cross this one">
                        <StackPanel>
                            <CheckBox x:Name="other_main" Content="Show their main bars"/>
                            <CheckBox x:Name="other_links" Content="Show their links (e.g. when links run in both directions)"/>
                        </StackPanel>
                    </GroupBox>
                    <WrapPanel>
                        <CheckBox x:Name="unobscure" Content="Show rebar unobscured"/>
                        <CheckBox x:Name="fine" Content="Fine detail level"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Tags and dimensions">
                <StackPanel>
                    <GroupBox Header="Tags">
                        <StackPanel>
                            <WrapPanel><TextBlock Text="Beam tag" Width="110"/><ComboBox x:Name="beam_tag" Width="330"/></WrapPanel>
                            <WrapPanel><TextBlock Text="Main bar tag" Width="110"/><ComboBox x:Name="bar_tag" Width="330"/></WrapPanel>
                            <TextBlock Foreground="Gray" Text="One tag per bar (each lapped piece gets its own): top bars above the beam, bottom bars below."/>
                            <WrapPanel><TextBlock Text="Link tag" Width="110"/><ComboBox x:Name="link_tag" Width="330"/></WrapPanel>
                            <CheckBox x:Name="tag_leader" Content="Tags with leader"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox>
                        <GroupBox.Header><CheckBox x:Name="link_mra" Content="Links: multi-rebar annotation (placed above the bar tag)" Margin="0"/></GroupBox.Header>
                        <WrapPanel><TextBlock Text="Type" Width="110"/><ComboBox x:Name="mra_type" Width="330"/></WrapPanel>
                    </GroupBox>
                    <GroupBox>
                        <GroupBox.Header><CheckBox x:Name="lap_dims" Content="Dimension each lap" Margin="0"/></GroupBox.Header>
                        <StackPanel>
                            <WrapPanel><TextBlock Text="Dimension type" Width="110"/><ComboBox x:Name="lap_dim_type" Width="330"/></WrapPanel>
                            <WrapPanel><TextBlock Text="Suffix" Width="110"/><TextBox x:Name="lap_suffix" Width="150"/>
                                <TextBlock Foreground="Gray" Text="e.g.  (overlap)  - empty if your type has it"/></WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <CheckBox x:Name="grid_dims" Content="Dimension between grids in long sections"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Labels">
                <StackPanel>
                    <GroupBox Header="Section names (A-A, A1-A1...)">
                        <StackPanel>
                            <CheckBox x:Name="label_plan" Content="Next to the section marks in the plan (run from a plan view)"/>
                            <CheckBox x:Name="mark_labels" Content="Next to the section lines inside the long sections and cross sections"/>
                            <WrapPanel><TextBlock Text="Text type" Width="110"/><ComboBox x:Name="label_type" Width="330"/></WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="View title">
                        <StackPanel>
                            <CheckBox x:Name="label_view" Content="Write the view name under the beam inside each view"/>
                            <WrapPanel><TextBlock Text="Text type" Width="110"/><ComboBox x:Name="title_type" Width="330"/></WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <CheckBox x:Name="avoid_clash" Content="Keep section marks from colliding (widens only the view's white margin)"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="cancel_click"/>
            <Button Content="Create views" Width="120" IsDefault="True" Click="ok_click"/>
        </WrapPanel>
    </StackPanel>
</Window>
