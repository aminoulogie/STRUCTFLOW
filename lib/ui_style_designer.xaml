<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructFlow - Style Designer" Width="1180" Height="720"
        WindowStartupLocation="CenterScreen" FontSize="12" PreviewKeyDown="key_down">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,2,6,2"/><Setter Property="Width" Value="70"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,2,6,2"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,10,2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="0,4,6,0"/><Setter Property="Padding" Value="8,3"/></Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <ComboBox x:Name="kind" DockPanel.Dock="Top" SelectionChanged="kind_changed"/>
            <Button DockPanel.Dock="Bottom" Content="Delete this type..." Click="delete_type_click"/>
            <ListBox x:Name="types" SelectionChanged="type_changed"/>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <WrapPanel DockPanel.Dock="Bottom">
                <TextBlock Text="Zoom"/>
                <Slider x:Name="zoom" Width="160" Minimum="2" Maximum="80" Value="10" VerticalAlignment="Center" ValueChanged="redraw_evt"/>
                <Button Content="Fit" Click="fit_view"/><Button Content="Undo" Click="undo"/><Button Content="Redo" Click="redo"/>
                <TextBlock Foreground="Gray" Text="  wheel = zoom, hold wheel = pan, Ctrl+Z / Ctrl+Y"/>
            </WrapPanel>
            <Border BorderBrush="Gainsboro" BorderThickness="1" ClipToBounds="True">
                <Canvas x:Name="canvas" Background="White" ClipToBounds="True"
                        MouseWheel="canvas_wheel" MouseDown="canvas_down" MouseMove="canvas_move" MouseUp="canvas_up"/>
            </Border>
        </DockPanel>
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Text" FontWeight="Bold"/>
                <WrapPanel><TextBlock Text="Font" Width="110"/><ComboBox x:Name="font" Width="160" IsEditable="True" KeyUp="changed" SelectionChanged="changed"/></WrapPanel>
                <WrapPanel><TextBlock Text="Size (mm)" Width="110"/><ComboBox x:Name="size" Width="80" IsEditable="True" KeyUp="changed" SelectionChanged="changed"/></WrapPanel>
                <WrapPanel><TextBlock Text="Width factor" Width="110"/><TextBox x:Name="width" TextChanged="changed"/></WrapPanel>
                <WrapPanel><CheckBox x:Name="bold" Content="Bold" Click="changed"/><CheckBox x:Name="italic" Content="Italic" Click="changed"/>
                           <CheckBox x:Name="underline" Content="Underline" Click="changed"/></WrapPanel>
                <WrapPanel><TextBlock Text="Colour R,G,B" Width="110"/><TextBox x:Name="colour" Width="100" TextChanged="changed"/></WrapPanel>
                <WrapPanel><TextBlock Text="Line weight (pen)" Width="110"/><ComboBox x:Name="pen" Width="60" SelectionChanged="changed"/></WrapPanel>
                <WrapPanel><CheckBox x:Name="opaque" Content="Opaque background (masks lines behind)" Click="changed"/></WrapPanel>

                <StackPanel x:Name="dim_panel">
                    <TextBlock Text="Dimension" FontWeight="Bold" Margin="0,10,0,0"/>
                    <WrapPanel><TextBlock Text="Tick mark" Width="110"/><ComboBox x:Name="tick" Width="190" SelectionChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Tick weight (pen)" Width="110"/><ComboBox x:Name="tick_pen" Width="60" SelectionChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Witness gap (mm)" Width="110"/><TextBox x:Name="gap" TextChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Witness ext. (mm)" Width="110"/><TextBox x:Name="ext" TextChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Dim line ext. (mm)" Width="110"/><TextBox x:Name="dimext" TextChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Text offset (mm)" Width="110"/><TextBox x:Name="offset" TextChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Prefix / suffix" Width="110"/><TextBox x:Name="prefix" Width="60" TextChanged="changed"/>
                               <TextBox x:Name="suffix" Width="100" TextChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Sample value" Width="110"/><TextBox x:Name="sample" TextChanged="changed"/></WrapPanel>
                </StackPanel>
                <StackPanel x:Name="tick_panel">
                    <TextBlock Text="Tick mark" FontWeight="Bold" Margin="0,10,0,0"/>
                    <WrapPanel><TextBlock Text="Style" Width="110"/><ComboBox x:Name="t_style" Width="140" SelectionChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Size (mm)" Width="110"/><TextBox x:Name="t_size" TextChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Angle (deg)" Width="110"/><TextBox x:Name="t_angle" TextChanged="changed"/>
                               <TextBlock Foreground="Gray" Text="arrows: width angle"/></WrapPanel>
                    <WrapPanel><CheckBox x:Name="t_filled" Content="Filled" Click="changed"/><CheckBox x:Name="t_closed" Content="Closed" Click="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Heavy end pen" Width="110"/><ComboBox x:Name="t_pen" Width="60" SelectionChanged="changed"/></WrapPanel>
                    <Button Content="Create the EPL tick set" Click="epl_ticks_click"/>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap"
                               Text="EPL_Tick_Diagonal_3mm / 2mm, Dot 1.5mm, Arrow 15 / 30 deg. Then pick them as Tick mark on your dimension styles."/>
                </StackPanel>
                <StackPanel x:Name="text_panel">
                    <TextBlock Text="Text note" FontWeight="Bold" Margin="0,10,0,0"/>
                    <WrapPanel><CheckBox x:Name="border" Content="Show border" Click="changed"/>
                               <TextBlock Text="offset (mm)"/><TextBox x:Name="border_offset" Width="50" TextChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Leader arrow" Width="110"/><ComboBox x:Name="leader" Width="190" SelectionChanged="changed"/></WrapPanel>
                    <WrapPanel><TextBlock Text="Sample text" Width="110"/><TextBox x:Name="sample_text" Width="190" TextChanged="changed"/></WrapPanel>
                </StackPanel>

                <TextBlock Text="Save" FontWeight="Bold" Margin="0,14,0,0"/>
                <Button Content="Apply to this type" Click="apply_click"/>
                <WrapPanel><TextBox x:Name="new_name" Width="200"/><Button Content="Save as new type" Click="save_new_click"/></WrapPanel>
                <Button Content="Revert to what the model has" Click="revert_click"/>
                <TextBlock x:Name="status" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
