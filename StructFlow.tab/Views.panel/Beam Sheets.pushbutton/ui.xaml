<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructFlow - Beam Sheets" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Width" Value="60"/><Setter Property="Margin" Value="0,2,12,2"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Width" Value="330"/><Setter Property="Margin" Value="0,2,12,2"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock x:Name="info" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <GroupBox Header="Sheets">
            <StackPanel>
                <WrapPanel><TextBlock Text="Title block" Width="110"/><ComboBox x:Name="title_block"/></WrapPanel>
                <WrapPanel><TextBlock Text="Viewport type" Width="110"/><ComboBox x:Name="vp_type"/></WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Number" Width="110"/><TextBox x:Name="number_prefix"/>
                    <TextBlock Text="starting at"/><TextBox x:Name="number_start"/>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Sheet name" Width="110"/><TextBox x:Name="sheet_name" Width="250"/>
                    <TextBlock Foreground="Gray" Text="{n} = 1, 2, 3..."/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Drawing area inside the title block (mm on paper)">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Left"/><TextBox x:Name="m_left"/>
                    <TextBlock Text="Right"/><TextBox x:Name="m_right"/>
                    <TextBlock Text="Top"/><TextBox x:Name="m_top"/>
                    <TextBlock Text="Bottom"/><TextBox x:Name="m_bottom"/>
                </WrapPanel>
                <TextBlock Foreground="Gray" TextWrapping="Wrap"
                           Text="Make the right or bottom margin as big as your title strip so no view lands on it."/>
                <WrapPanel>
                    <TextBlock Text="Gap between views"/><TextBox x:Name="gap_x"/>
                    <TextBlock Text="Gap between rows (room for view titles)"/><TextBox x:Name="gap_y"/>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Align views in a row"/><ComboBox x:Name="align" Width="120"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Each beam starts a new row: its long section, then its cross sections A1, A2... in order along the beam. Rows fill the sheet top to bottom; a new sheet is added when one is full. Views already on a sheet are skipped."/>
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="cancel_click"/>
            <Button Content="Create sheets" Width="120" IsDefault="True" Click="ok_click"/>
        </WrapPanel>
    </StackPanel>
</Window>
