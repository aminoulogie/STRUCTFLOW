<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructFlow - Type Maker" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Width" Value="300"/><Setter Property="Margin" Value="0,2,12,2"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,2"/></Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <WrapPanel><TextBlock Text="Category" Width="120"/><ComboBox x:Name="category" SelectionChanged="category_changed"/></WrapPanel>
        <WrapPanel><TextBlock x:Name="base_label" Text="Family" Width="120"/><ComboBox x:Name="base" SelectionChanged="base_changed"/></WrapPanel>
        <StackPanel x:Name="param_panel">
            <WrapPanel><TextBlock Text="Width parameter" Width="120"/><ComboBox x:Name="p_w" Width="160"/></WrapPanel>
            <WrapPanel><TextBlock Text="Depth parameter" Width="120"/><ComboBox x:Name="p_h" Width="160"/></WrapPanel>
        </StackPanel>
        <WrapPanel>
            <TextBlock Text="Type name" Width="120"/><TextBox x:Name="pattern" Width="200" Margin="0,2,8,2"/>
            <TextBlock x:Name="pattern_hint" Foreground="Gray"/>
        </WrapPanel>
        <TextBlock x:Name="sizes_hint" Margin="0,8,0,2" TextWrapping="Wrap"/>
        <TextBox x:Name="sizes" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <CheckBox x:Name="update" Content="Update types that already exist with the same name" IsChecked="True"/>
        <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="cancel_click"/>
            <Button Content="Create types" Width="120" IsDefault="True" Click="ok_click"/>
        </WrapPanel>
    </StackPanel>
</Window>
