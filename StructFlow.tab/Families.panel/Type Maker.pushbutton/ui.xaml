<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructFlow - Type Maker" Width="1020" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,2,12,2"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Width" Value="250"/><Setter Property="Margin" Value="0,2,12,2"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,2"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="322"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>

            <GroupBox Header="Preview (updates as you type)" Grid.Column="0" VerticalAlignment="Top">
                <Canvas x:Name="preview" Width="300" Height="541"/>
            </GroupBox>

            <StackPanel Grid.Column="2">
                <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="Category" Width="80"/><ComboBox x:Name="category" SelectionChanged="category_changed"/>
                </WrapPanel>
                <TabControl Padding="8">
                    <TabItem Header="Sizes">
                        <StackPanel>
                            <WrapPanel><TextBlock x:Name="base_label" Text="Family" Width="140"/><ComboBox x:Name="base" Width="300" SelectionChanged="base_changed"/></WrapPanel>
                            <CheckBox x:Name="edit_mode" Content="Edit the existing types (loads them into the list below)" Click="edit_changed"/>
                            <StackPanel x:Name="param_panel">
                                <WrapPanel><TextBlock Text="Width parameter" Width="140"/><ComboBox x:Name="p_w" Width="160"/></WrapPanel>
                                <WrapPanel><TextBlock Text="Depth parameter" Width="140"/><ComboBox x:Name="p_h" Width="160"/></WrapPanel>
                            </StackPanel>
                            <WrapPanel>
                                <TextBlock Text="New type name" Width="140"/><TextBox x:Name="pattern" Width="180"/>
                                <TextBlock x:Name="pattern_hint" Foreground="Gray"/>
                            </WrapPanel>
                            <StackPanel x:Name="types_panel" Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock Text="Types in this family - click one to see its look and material (Ctrl / Shift for several):"/>
                                <ListBox x:Name="types_list" Height="120" SelectionMode="Extended" SelectionChanged="type_selected"/>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="Delete selected types..." Padding="10,2" Click="delete_types"/>
                                    <TextBlock Foreground="Gray" Margin="10,0,0,0" Text="asks first; types placed in the model are reported"/>
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock x:Name="sizes_hint" Margin="0,8,0,2" TextWrapping="Wrap"/>
                            <TextBox x:Name="sizes" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                            <CheckBox x:Name="update" Content="Update types that already exist with the same name" IsChecked="True"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Graphics">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Preset" Width="140"/><ComboBox x:Name="preset" SelectionChanged="preset_changed"/>
                            </WrapPanel>
                            <TextBlock x:Name="preset_note" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <GroupBox Header="Lines (Object Styles - every element of this category)">
                                <StackPanel>
                                    <WrapPanel><TextBlock Text="Line colour" Width="140"/><ComboBox x:Name="colour" IsEditable="True" Width="160"/></WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Cut line weight" Width="140"/><ComboBox x:Name="cut_w" Width="60"/>
                                        <TextBlock Text="Projection weight"/><ComboBox x:Name="proj_w" Width="60"/>
                                    </WrapPanel>
                                    <WrapPanel><TextBlock Text="Projection pattern" Width="140"/><ComboBox x:Name="proj_pattern"/></WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Hidden lines pattern" Width="140"/><ComboBox x:Name="hidden_pattern"/>
                                        <TextBlock Text="weight"/><ComboBox x:Name="hidden_w" Width="60"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Material graphics (cut, faces, 3D)">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Cut pattern" Width="140"/><ComboBox x:Name="cut_fill"/>
                                        <TextBlock Text="colour"/><ComboBox x:Name="cut_fill_colour" IsEditable="True" Width="130"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Surface pattern" Width="140"/><ComboBox x:Name="surface_fill"/>
                                        <TextBlock Text="colour"/><ComboBox x:Name="surface_colour" IsEditable="True" Width="130"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="3D shaded colour" Width="140"/><ComboBox x:Name="shade" IsEditable="True" Width="160"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Transparency" Width="140"/>
                                        <Slider x:Name="transparency" Width="200" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=transparency, Path=Value, StringFormat={}{0:0}%}" Width="40"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>
                            <CheckBox x:Name="apply_styles" Content="Apply the line settings to Object Styles (all elements of this category)" IsChecked="True"/>
                            <CheckBox x:Name="apply_view" Content="Also write them into the active view's template overrides (Visibility/Graphics)"/>
                            <TextBlock Foreground="Gray" Text="Colours: a name (Black, Pink, Concrete...) or R,G,B such as 255,0,128."/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Material">
                        <StackPanel>
                            <WrapPanel><TextBlock Text="Material name" Width="160"/><TextBox x:Name="mat_name" Width="300"/></WrapPanel>
                            <WrapPanel><TextBlock Text="Concrete grade (BS 8500)" Width="160"/><ComboBox x:Name="grade" Width="120" SelectionChanged="grade_changed"/></WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="fck (MPa)" Width="160"/><TextBox x:Name="fck" Width="70"/>
                                <TextBlock Text="Ecm (GPa)"/><TextBox x:Name="ecm" Width="70"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="Density (kg/m3)" Width="160"/><TextBox x:Name="density" Width="70"/>
                                <TextBlock Text="Poisson's ratio"/><TextBox x:Name="poisson" Width="70"/>
                            </WrapPanel>
                            <WrapPanel><TextBlock Text="Thermal expansion (x10^-6 /C)" Width="160"/><TextBox x:Name="thermal" Width="70"/></WrapPanel>
                            <WrapPanel><TextBlock Text="Description" Width="160"/><TextBox x:Name="description" Width="380"/></WrapPanel>
                            <WrapPanel><TextBlock Text="Keynote" Width="160"/><TextBox x:Name="keynote" Width="120"/></WrapPanel>
                            <CheckBox x:Name="apply_material" Content="Create / update this material (graphics + structural properties) and assign it to the types"
                                      IsChecked="True"/>
                            <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Fck and Ecm follow BS EN 1992-1-1 Table 3.1 when you pick a grade. Density 2500 kg/m3 = 25 kN/m3 reinforced concrete (BS EN 1991-1-1)."/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Grid>
        <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="cancel_click"/>
            <Button Content="Apply" Width="120" IsDefault="True" Click="ok_click"/>
        </WrapPanel>
    </StackPanel>
</Window>
