<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructFlow - Symbol Designer" Width="1280" Height="780"
        WindowStartupLocation="CenterScreen" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,2,8,2"/></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="0,3,6,3"/><Setter Property="Padding" Value="8,2"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,2,8,2"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- left: what to design -->
        <DockPanel Grid.Column="0">
            <GroupBox DockPanel.Dock="Top" Header="1  Symbol">
                <ListBox x:Name="kinds" Height="300" SelectionChanged="kind_changed"/>
            </GroupBox>
            <GroupBox DockPanel.Dock="Top" Header="2  Base family (gives the labels)">
                <StackPanel>
                    <ComboBox x:Name="base" IsEditable="True" IsTextSearchEnabled="True"/>
                    <Button Content="Read its labels" Click="read_labels"/>
                    <TextBlock x:Name="base_info" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>
            <GroupBox DockPanel.Dock="Top" Header="Designs">
                <WrapPanel>
                    <Button Content="Reset to preset" Click="reset_preset"/>
                    <Button Content="Open..." Click="open_design"/>
                    <Button Content="Save..." Click="save_design"/>
                </WrapPanel>
            </GroupBox>
            <TextBlock Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Top"
                       Text="Drag shapes and labels on the canvas, or type exact values on the right. Sizes are mm on paper; the cross is the family origin."/>
        </DockPanel>

        <!-- middle: canvas -->
        <DockPanel Grid.Column="2">
            <WrapPanel DockPanel.Dock="Top">
                <TextBlock Text="Add:"/>
                <Button Content="Circle" Click="add_circle"/><Button Content="Line" Click="add_line"/>
                <Button Content="Rectangle" Click="add_rect"/><Button Content="Triangle" Click="add_triangle"/>
                <Button Content="Arrow" Click="add_arrow"/><Button Content="Dot" Click="add_dot"/>
                <Button Content="Polygon" Click="add_polygon"/>
                <Button Content="Text" Click="add_text"/>
                <Button Content="Rotate -15" Click="rot_left"/><Button Content="Rotate +15" Click="rot_right"/>
                <Button Content="Duplicate" Click="duplicate"/><Button Content="Delete" Click="delete"/>
            </WrapPanel>
            <WrapPanel DockPanel.Dock="Bottom">
                <TextBlock Text="Zoom"/>
                <Slider x:Name="zoom" Width="180" Minimum="4" Maximum="40" Value="14" VerticalAlignment="Center" ValueChanged="zoom_changed"/>
                <CheckBox x:Name="snap" Content="Snap 0.5 mm" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock x:Name="cursor" Foreground="Gray" Margin="16,0,0,0"/>
            </WrapPanel>
            <Border BorderBrush="Gainsboro" BorderThickness="1" ClipToBounds="True">
                <Canvas x:Name="canvas" Background="White" ClipToBounds="True"
                        MouseLeftButtonDown="canvas_down" MouseMove="canvas_move" MouseLeftButtonUp="canvas_up"/>
            </Border>
        </DockPanel>

        <!-- right: properties and output -->
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Shapes">
                    <ListBox x:Name="shapes" Height="130" SelectionChanged="shape_picked"/>
                </GroupBox>
                <GroupBox Header="Labels (from the base family) - what each one shows">
                    <ListBox x:Name="labels" Height="90" SelectionChanged="label_picked"/>
                </GroupBox>
                <GroupBox x:Name="props_box" Header="Properties">
                    <StackPanel>
                        <WrapPanel><TextBlock x:Name="l_x" Text="X" Width="55"/><TextBox x:Name="f_x" Width="60" TextChanged="prop_changed"/>
                                   <TextBlock x:Name="l_y" Text="Y" Width="55"/><TextBox x:Name="f_y" Width="60" TextChanged="prop_changed"/></WrapPanel>
                        <WrapPanel><TextBlock x:Name="l_a" Text="A" Width="55"/><TextBox x:Name="f_a" Width="60" TextChanged="prop_changed"/>
                                   <TextBlock x:Name="l_b" Text="B" Width="55"/><TextBox x:Name="f_b" Width="60" TextChanged="prop_changed"/></WrapPanel>
                        <WrapPanel><TextBlock Text="Pen" Width="55"/><ComboBox x:Name="f_pen" Width="60" SelectionChanged="prop_changed"/>
                                   <CheckBox x:Name="f_fill" Content="Filled (solid black)" VerticalAlignment="Center" Click="prop_changed"/></WrapPanel>
                        <WrapPanel><TextBlock Text="Direction" Width="55"/><ComboBox x:Name="f_dir" Width="90" SelectionChanged="prop_changed"/>
                                   <TextBlock Text="Rotate" Width="45"/><TextBox x:Name="f_rot" Width="50" TextChanged="prop_changed"/><TextBlock Text="deg"/></WrapPanel>
                        <WrapPanel><TextBlock Text="Head" Width="55"/><TextBox x:Name="f_head" Width="60" TextChanged="prop_changed"/>
                                   <TextBlock Foreground="Gray" Text="arrow head length (mm)"/></WrapPanel>
                        <WrapPanel><TextBlock Text="Text" Width="55"/><TextBox x:Name="f_text" Width="200" TextChanged="prop_changed"/></WrapPanel>
                        <CheckBox x:Name="f_box" Content="Box around the label (grows with the text)" Click="prop_changed"/>
                        <WrapPanel><TextBlock Text="Box gap" Width="55"/><TextBox x:Name="f_gap" Width="60" TextChanged="prop_changed"/>
                                   <TextBlock Foreground="Gray" Text="mm between text and box"/></WrapPanel>
                        <WrapPanel><TextBlock Text="Height" Width="55"/><ComboBox x:Name="f_h" Width="70" IsEditable="True" SelectionChanged="prop_changed" KeyUp="prop_changed"/>
                                   <TextBlock Text="Font"/><TextBox x:Name="f_font" Width="90" TextChanged="prop_changed"/></WrapPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="3  Build">
                    <StackPanel>
                        <WrapPanel><TextBlock Text="EPL name" Width="70"/><TextBox x:Name="out_name" Width="240"/></WrapPanel>
                        <WrapPanel><TextBlock Text="Folder" Width="70"/><TextBox x:Name="out_folder" Width="240"/></WrapPanel>
                        <WrapPanel><TextBlock Text="Library" Width="70"/><TextBox x:Name="out_root" Width="240"/></WrapPanel>
                        <CheckBox x:Name="save_file" Content="Save the .rfa into the EPL library" IsChecked="True"/>
                        <CheckBox x:Name="load_model" Content="Load it into this model" IsChecked="True"/>
                        <Button Content="Build family" FontWeight="Bold" Padding="16,4" Click="build_click"/>
                        <TextBlock x:Name="status" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
