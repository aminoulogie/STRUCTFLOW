<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructFlow - Beam Views" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Width" Value="60"/><Setter Property="Margin" Value="0,2,12,2"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Width" Value="220"/><Setter Property="Margin" Value="0,2,12,2"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="6"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,14,2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock x:Name="info" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <GroupBox Header="Setup (save one per client / project standard)">
            <WrapPanel>
                <ComboBox x:Name="preset" IsEditable="True" SelectionChanged="preset_changed"/>
                <Button Content="Save setup" Width="90" Margin="0,0,8,0" Click="save_click"/>
                <Button Content="Delete" Width="70" Click="delete_click"/>
            </WrapPanel>
        </GroupBox>

        <GroupBox Header="View type">
            <WrapPanel>
                <TextBlock Text="Section type"/><ComboBox x:Name="section_type"/>
                <TextBlock Text="Margin around beam (mm)"/><TextBox x:Name="margin"/>
            </WrapPanel>
        </GroupBox>

        <GroupBox>
            <GroupBox.Header><CheckBox x:Name="make_elev" Content="Long section / elevation along the beam" Margin="0"/></GroupBox.Header>
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Scale 1 :"/><ComboBox x:Name="scale_elev" IsEditable="True" Width="70"/>
                    <TextBlock Text="View template"/><ComboBox x:Name="template_elev"/>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Name"/><TextBox x:Name="elev_name" Width="300"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Cross sections">
            <StackPanel>
                <WrapPanel>
                    <CheckBox x:Name="sec_start" Content="Start"/>
                    <CheckBox x:Name="sec_mid" Content="Midspan"/>
                    <CheckBox x:Name="sec_end" Content="End"/>
                    <CheckBox x:Name="per_span" Content="For every span (between supports)"/>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Start/end cut from support face (mm)"/><TextBox x:Name="sec_offset"/>
                    <TextBlock Text="View depth (mm)"/><TextBox x:Name="sec_depth"/>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Scale 1 :"/><ComboBox x:Name="scale_section" IsEditable="True" Width="70"/>
                    <TextBlock Text="View template"/><ComboBox x:Name="template_section"/>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Name"/><TextBox x:Name="sec_name" Width="300"/>
                </WrapPanel>
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Text="Name codes: {L} beam letter (A, B, C... one per beam, kept on re-run), {n} section number 1, 2, 3 in that beam, {mark} beam mark, {type} beam type. Example: long section {L}-{L} gives A-A; cross section {L}{n}-{L}{n} gives A1-A1, A2-A2."/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Annotations">
            <StackPanel>
                <WrapPanel><TextBlock Text="Beam tag" Width="90"/><ComboBox x:Name="beam_tag" Width="300"/></WrapPanel>
                <WrapPanel><TextBlock Text="Main bar tag" Width="90"/><ComboBox x:Name="bar_tag" Width="300"/></WrapPanel>
                <WrapPanel><TextBlock Text="Link tag" Width="90"/><ComboBox x:Name="link_tag" Width="300"/></WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="tag_leader" Content="Rebar tags with leader"/>
                    <CheckBox x:Name="unobscure" Content="Show rebar unobscured"/>
                    <CheckBox x:Name="fine" Content="Fine detail level"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Labels and layout">
            <StackPanel>
                <WrapPanel>
                    <CheckBox x:Name="label_plan" Content="Write view names next to the section marks in the plan (run from a plan view)"/>
                </WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="label_view" Content="Write the name inside each section view"/>
                    <CheckBox x:Name="grid_dims" Content="Dimension between grids in long sections"/>
                </WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="avoid_clash" Content="Keep section marks from colliding (widens the view's white margin only)"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <CheckBox x:Name="replace_old" Content="Replace views StructFlow made before for these beams"/>
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8"
                   Text="If a view template controls scale or detail level, the template wins."/>

        <WrapPanel HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="cancel_click"/>
            <Button Content="Create views" Width="120" IsDefault="True" Click="ok_click"/>
        </WrapPanel>
    </StackPanel>
</Window>
