<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StructFlow - System Types Navigator" Width="1080" Height="700"
        WindowStartupLocation="CenterScreen" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Margin" Value="0,4,0,0"/><Setter Property="Padding" Value="8,3"/></Style>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="System families" Margin="0,0,0,4"/>
            <ListBox x:Name="groups" SelectionChanged="group_changed"/>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Search "/><TextBox x:Name="search" Width="180" TextChanged="refresh"/>
                <CheckBox x:Name="only_unused" Content="Only unused" Margin="12,0,0,0" VerticalAlignment="Center" Click="refresh"/>
            </WrapPanel>
            <WrapPanel DockPanel.Dock="Bottom">
                <Button Content="Tick all shown" Click="tick_all" Margin="0,4,6,0"/>
                <Button Content="Tick unused" Click="tick_unused" Margin="0,4,6,0"/>
                <Button Content="Untick all" Click="untick_all" Margin="0,4,6,0"/>
                <TextBlock x:Name="count" Foreground="Gray" Margin="12,0,0,0"/>
            </WrapPanel>
            <ListBox x:Name="items" SelectionChanged="item_selected"/>
        </DockPanel>
        <StackPanel Grid.Column="4">
            <TextBlock x:Name="detail" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,8"/>
            <TextBlock Text="Ticked types:" FontWeight="Bold"/>
            <Button Content="Delete ticked..." Click="delete_click"/>
            <TextBlock Text="Merge ticked into:" Margin="0,10,0,0"/>
            <ComboBox x:Name="merge_into"/>
            <Button Content="Merge (move users, then delete)" Click="merge_click"/>
            <TextBlock Text="Selected type:" FontWeight="Bold" Margin="0,16,0,0"/>
            <TextBox x:Name="new_name"/>
            <Button Content="Rename" Click="rename_click"/>
            <Button Content="Duplicate as this name" Click="duplicate_click"/>
            <Button Content="Select its users in the model" Click="select_users"/>
            <Button Content="Open in Style Designer" Click="open_designer"/>
            <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Deleting a type that is in use also deletes the elements using it: use Merge to keep them. Every action is logged and undoable with Ctrl+Z."/>
        </StackPanel>
    </Grid>
</Window>
